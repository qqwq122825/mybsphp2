APP_NAME=MyBsPHP
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
# 首次访问会自动生成合法密钥；也可手动执行：php artisan key:generate
APP_KEY=
APP_INSTALLED=false
ADMIN_PATH=admin
ADMIN_SECONDARY_PASSWORD_ENABLED=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mybsphp
DB_USERNAME=root
DB_PASSWORD=

SESSION_NAME=mybsphp_session
SESSION_LIFETIME=7200
